    "autoprefixer": "^10.4.19",
    "axe-core": "^4.13.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.5",
    "husky": "^9.1.4",
    "jsdom": "^24.1.0",
    "kysely-codegen": "^0.14.1",
    "lint-staged": "^15.2.7",
    "postcss": "^8.4.40",
    "prettier": "^3.9.6",
