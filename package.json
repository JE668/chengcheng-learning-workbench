{
  "name": "chengcheng-learning-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "node scripts/seed.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "analyze": "ANALYZE=true next build",
    "db:generate": "kysely-codegen --out-file src/lib/db/generated.ts --dialect sqlite --url file:local.db",
    "db:migrate": "node scripts/migrate.mjs",
    "prepare": "husky install"
  },
  "dependencies": {
