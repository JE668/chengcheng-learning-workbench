    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "hanzi-writer": "^3.7.3",
    "kysely": "^0.27.3",
    "lucide-react": "^1.34.0",
    "next": "14.2.5",
    "pdfjs-dist": "^6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "ws": "^8.18.0",
    "zod": "^3.23.8",
    "zustand": "^4.5.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.3.0",
