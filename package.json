    "next": "14.2.5",
    "pdfjs-dist": "6.2.108",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^2.4.0",
    "web-push": "^3.6.7",
    "web-vitals": "^6.2.1",
    "ws": "^8.18.0",
    "zod": "^4.4.3",
    "zustand": "^4.5.4"
