# ---- 数据库 ----
# 默认本地文件，挂卷到容器 /data（见 docker-compose.yml）
TURSO_URL=file:/data/local.db
# 如需改用 Turso 云端（可选，非必须）：
# TURSO_URL=libsql://xxxx.turso.io
# TURSO_AUTH_TOKEN=xxxx
# 仅当 TURSO_URL 指向云端时需要，上面那行取消注释即可

# ---- 应用 ----
NODE_ENV=production
NEXT_TELEMETRY_DISABLED=1
PORT=3000
HOSTNAME=0.0.0.0
# 时区：容器内默认 UTC 会让 dateStr()（本地时间）算出的「今天」比北京时间晚一天。
# 设成上海，保证打卡/城堡结算按北京时间算。
TZ=Asia/Shanghai
# 站点显示名（登录页与 PWA 标题使用）
# NEXT_PUBLIC_APP_NAME=程程学习工作台
# 上报 Web Vitals 到 Sentry；留空则不上报
# NEXT_PUBLIC_SEND_WEB_VITALS=1

# ---- 会话与登录安全 ----
# 登录态有效期（天），默认 7。清理过期会话的 SQL 与它对齐
# SESSION_TTL_DAYS=7
# 会话 cookie 名，默认 session。除非你有多个应用共用反代，否则不要改
# SESSION_COOKIE=session
# 是否给会话 cookie 打 Secure 标记。
# 留空（不设置）时自动判断：优先信任反代透传的 x-forwarded-proto，
# 无该头时回退 false —— 这样局域网 http 直连也能正常登录。
# ⚠️ 不要在纯 http 局域网部署时硬设为 true，浏览器会拒收导致反复跳登录。
# 可显式强制：true / false
# SECURE_COOKIE=
# 登录限流：每个 IP 在窗口内最多尝试次数
# LOGIN_RATE_LIMIT_WINDOW=300     # 窗口秒数，默认 5 分钟
# LOGIN_RATE_LIMIT_MAX=10         # 窗口内上限，默认 10 次
# 账号级防爆破：同一用户名连续失败达到该次数即锁定
# MAX_LOGIN_FAILS=5
# LOGIN_LOCK_SECONDS=900          # 锁定时长，默认 15 分钟

# ---- 定时结算（城堡每日结算 / 会话清理）----
# 用于 /api/cron/settle 的调用鉴权（Vercel Cron、NAS 计划任务、容器 cron 都带这个密钥）。
# 必须设置一个足够随机的值，例如：`openssl rand -hex 32` 生成。
# 留空则该接口始终 401，结算只能靠有人打开页面时懒触发（settleCastle 在 getCastleState 内执行）。
CRON_SECRET=

# ---- AI 出题（可选）----
# /api/ai/generate 调用 NVIDIA 的 OpenAI 兼容接口生成题目。
# 留空则该接口返回 500，其余功能不受影响。
# NVIDIA_API_KEY=

# ---- Edge TTS 诊断（可选，一般不用改）----
# 开启 /api/tts-debug 诊断端点（会对外发起多次探测并回传上游响应）。
# ⚠️ 默认关闭；仅在排查语音问题时临时设为 true，排查完记得改回。
# ENABLE_TTS_DEBUG=false
# Edge TTS 备用令牌（默认内置，一般无需设置）
# EDGE_TTS_TOKEN=

# ---- 数据库备份 ----
# 每日自动备份（POST /api/cron/backup，见 DEPLOY-NAS.md）保留的备份份数，默认 14。
# 设 0 表示不清理旧备份。
# BACKUP_KEEP_COUNT=14

# ---- Sentry 错误监控 ----
# 在 https://sentry.io/settings/projects/ 创建项目后获取 DSN
# 留空则禁用 Sentry（不上传 sourcemap、不上报错误）
# SENTRY_DSN=https://xxx@o1319462.ingest.sentry.io/xxx

# ---- Web Push 推送通知（可选）----
# ⚠️ 安全提示：本项目历史上曾把一对**真实的 VAPID 密钥**硬编码进源码和本文件。
#    由于仓库是 public，那对密钥必须视为已泄露并已作废。
#    请自行生成新的一对，并且**只写到 NAS 的 .env 里，不要提交到仓库**：
#        npx web-push generate-vapid-keys
#
# 未配置（留空）时 Web Push 会自动禁用，登录、学习、打卡等功能不受影响。
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# 可选，默认 mailto:admin@example.com
# VAPID_SUBJECT=mailto:you@example.com
